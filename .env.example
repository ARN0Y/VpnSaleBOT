# ════════════════════════════════════════════════════════════════
#  NavidVPN Bot  —  نمونه فایل پیکربندی
#  این فایل را به نام  .env  کپی کنید و مقادیر را پر کنید:
#      cp .env.example .env
#  مقادیر داخل <...> را با اطلاعات واقعی خودتان جایگزین کنید.
# ════════════════════════════════════════════════════════════════

# ───────────── ربات تلگرام ─────────────
# توکن ربات از @BotFather
BOT_TOKEN=<توکن_ربات_از_BotFather>
# آیدی عددی یوزرنیم ربات (اختیاری، بدون @)
BOT_USERNAME=NavidVPN_Bot
# مسیر دیتابیس ربات (به‌صورت خودکار ساخته می‌شود اگر وجود نداشته باشد)
BOT_DB_PATH=/root/NavidVPN_Bot/navidvpn.db
# پروکسی برای اتصال ربات به تلگرام (اگر سرور به تلگرام دسترسی مستقیم دارد، خالی بگذارید)
# نمونه: socks5h://user:pass@127.0.0.1:1080
BOT_PROXY_URL=

# ───────────── ادمین‌های ربات ─────────────
# آیدی عددی ادمین اصلی (از @userinfobot بگیرید)
ADMIN_ID=<آیدی_عددی_شما>
# لیست ادمین‌ها (یک یا چند آیدی با کاما). اولین ورود به پنل و دسترسی‌های ادمین از این لیست خوانده می‌شود.
ADMIN_USER_IDS=<آیدی_عددی_شما>

# ───────────── پنل وب مدیریت (FastAPI) ─────────────
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
# نام کاربری و رمز ورود به پنل وب مدیریت NavidVPN (دلخواه شما)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=<یک_رمز_قوی_انتخاب_کنید>
# یک رشته تصادفی و طولانی برای امضای کوکی نشست (مثلا خروجی: openssl rand -hex 32)
ADMIN_SESSION_SECRET=<رشته_تصادفی_بلند>
# مدت اعتبار نشست به ثانیه (8 ساعت)
ADMIN_SESSION_TTL_SECONDS=28800
# اگر پنل پشت HTTPS است روی 1 بگذارید تا کوکی فقط روی https ارسال شود
ADMIN_COOKIE_SECURE=0

# ───────────── اتصال به پنل 3x-ui (xray) ─────────────
# آدرس کامل پنل 3x-ui به همراه مسیر امن (بدون اسلش انتهایی)
PANEL_BASE_URL=http://<آی‌پی_سرور>:<پورت>/<مسیر_امن>
PANEL_USERNAME=<یوزرنیم_پنل_3xui>
PANEL_PASSWORD=<پسورد_پنل_3xui>
# آیدی عددی inbound که کانفیگ‌ها داخل آن ساخته می‌شوند
PANEL_INBOUND_ID=<آیدی_اینباند>
# آدرس پایه لینک اشتراک (subscription) — بدون اسلش انتهایی
SUB_LINK_BASE=http://<دامنه_یا_آی‌پی>:<پورت>/sub

# ───────────── تنظیمات فروش و پرداخت ─────────────
# قیمت هر گیگابایت به تومان
PRICE_PER_GB=200000
# حداقل حجم مجاز خرید/تمدید (گیگ)
MIN_PURCHASE_GB=1
# اطلاعات کارت برای پرداخت کارت‌به‌کارت
CARD_NUMBER=<شماره_کارت>
CARD_NAME=<نام_صاحب_کارت>
# آدرس کیف پول تتر (USDT) برای پرداخت رمزارزی
CRYPTO_ADDRESS=<آدرس_تتر>
# آیدی پشتیبانی (با @)
SUPPORT_ID=@NavidVPN_Support

# وضعیت فروش: open یا closed
# SALES_STATUS وضعیت کلی، و دو کلید زیر برای کنترل جداگانه‌ی فروشِ کاربر عادی و نماینده هستند.
SALES_STATUS=open
SALES_STATUS_USER=open
SALES_STATUS_AGENT=open

# ───────────── بکاپ‌گیری (اختیاری) ─────────────
# آیدی چت/کانال تلگرام برای ارسال بکاپ‌ها، فقط از داخل پنل وب تنظیم می‌شود
# (مسیر: /admin/settings). تا وقتی تنظیم نشود، بکاپ به تلگرام ارسال نمی‌شود.
# سقف زمان بکاپ دیتابیس x-ui به ثانیه
BACKUP_XUI_TIMEOUT_SECONDS=180

# ───────────── کارایی (پیش‌فرض‌ها معمولاً کافی‌اند) ─────────────
# BROADCAST_RATE_PER_SECOND=25
# BROADCAST_CONCURRENCY=16
# BOT_TELEGRAM_POOL_SIZE=64
# BOT_PANEL_POOL_SIZE=128
# BOT_PANEL_TIMEOUT_SECONDS=20
